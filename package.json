{
  "name": "intdoorlab-web",
  "version": "0.1.0",
  "private": true,
  "description": "IntDoorLab — Independent Software Studio",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "prestart": "node -e \"if(!require('fs').existsSync('.next/BUILD_ID')) require('child_process').execSync('npm run build',{stdio:'inherit'})\"",
    "start": "next start -p 3001",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "motion": "^12.6.3",
    "next": "^15.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.4",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3"
  }
}

